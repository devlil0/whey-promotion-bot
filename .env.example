# ── Banco de dados ─────────────────────────────────────────────────────────────
# (Usados fora do Docker; dentro do Docker o compose sobrescreve automaticamente)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/whey_db
SPRING_DATASOURCE_USERNAME=whey_user
SPRING_DATASOURCE_PASSWORD=whey_pass

# ── Lojas ──────────────────────────────────────────────────────────────────────
GROWTH_API_APP_TOKEN=wapstore

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── WhatsApp (sidecar Baileys) ─────────────────────────────────────────────────
# WHATSAPP_BASE_URL: URL do sidecar Baileys.
#   Docker compose: http://baileys_sidecar:3000 (já definido no compose)
#   Local:          http://localhost:3000
WHATSAPP_BASE_URL=http://localhost:3000
# WHATSAPP_PHONE: JID do destino
#   Canal:  120363xxxxxxxxxxxxxxx@newsletter
#   Grupo:  120363xxxxxxxxxxxxxxx@g.us
#   DM:     5511999999999@s.whatsapp.net
WHATSAPP_PHONE=

# ── Segurança da API ───────────────────────────────────────────────────────────
API_KEY=
