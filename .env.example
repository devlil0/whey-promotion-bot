# ── Banco de dados ─────────────────────────────────────────────────────────────
# (Usados fora do Docker; dentro do Docker o compose sobrescreve automaticamente)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/whey_db
SPRING_DATASOURCE_USERNAME=whey_user
SPRING_DATASOURCE_PASSWORD=whey_pass

# ── Lojas ──────────────────────────────────────────────────────────────────────
GROWTH_API_APP_TOKEN=wapstore

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Evolution API (WhatsApp) ───────────────────────────────────────────────────
# EVOLUTION_API_KEY: senha que você escolhe para proteger sua instância Evolution
#   Gere com: [System.Guid]::NewGuid().ToString()  (PowerShell)
EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE: nome da instância WhatsApp (pode ser qualquer nome)
EVOLUTION_INSTANCE=whey-bot
# EVOLUTION_NUMBER: JID do grupo destino — preencher APÓS vincular o grupo
#   Exemplo: 120363xxxxxxxxxxxxxxx@g.us
#   Obter via: GET /api/whatsapp/setup/groups
EVOLUTION_NUMBER=
# EVOLUTION_SERVER_URL: URL pública do Evolution API (usada para gerar o QR code)
EVOLUTION_SERVER_URL=http://localhost:8081

# ── Segurança da API ───────────────────────────────────────────────────────────
API_KEY=
