# ── Banco de dados ─────────────────────────────────────────────────────────────
# (Usados fora do Docker; dentro do Docker o compose sobrescreve automaticamente)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/whey_db
SPRING_DATASOURCE_USERNAME=whey_user
SPRING_DATASOURCE_PASSWORD=whey_pass

# ── Lojas ──────────────────────────────────────────────────────────────────────
GROWTH_API_APP_TOKEN=wapstore

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Z-API (WhatsApp) ───────────────────────────────────────────────────────────
# ZAPI_INSTANCE_ID: ID da instância (painel Z-API → Instâncias Web → Dados da instância)
ZAPI_INSTANCE_ID=
# ZAPI_INSTANCE_TOKEN: token da instância (mesmo painel, abaixo do ID)
ZAPI_INSTANCE_TOKEN=
# ZAPI_CLIENT_TOKEN: token de segurança da CONTA (painel Z-API → Segurança / Account Security Token)
ZAPI_CLIENT_TOKEN=
# ZAPI_PHONE: JID do destino (canal, grupo ou número)
#   Canal:  120363xxxxxxxxxxxxxxx@newsletter
#   Grupo:  120363xxxxxxxxxxxxxxx@g.us
#   DM:     5511999999999
#   Listar canais: GET https://api.z-api.io/instances/$ID/token/$TOKEN/newsletter (header Client-Token)
ZAPI_PHONE=

# ── Segurança da API ───────────────────────────────────────────────────────────
API_KEY=
